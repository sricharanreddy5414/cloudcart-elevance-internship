# Copy to .env for the local EverShop stack. .env is gitignored.
# Do not put AWS access keys here.
# The running Windows stack already has its own database password.
# Leave that stack alone until you have confirmed the volume name.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=postgres

# Used only by the separate MySQL security lab. Never point EverShop at this database.
MYSQL_ROOT_PASSWORD=replace-with-a-local-mysql-password
MYSQL_DATABASE=cloudcart_security
MYSQL_USER=cloudcart_app
MYSQL_PASSWORD=replace-with-a-local-app-password
