{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPublishedImages",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::cloudcart-product-images-*/public/products/*"
    },
    {
      "Sid": "UploadToQuarantine",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::cloudcart-product-images-*/quarantine/*"
    },
    {
      "Sid": "ReadDatabaseSecret",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-south-1:*:secret:cloudcart/evershop/*"
    },
    {
      "Sid": "ReadConfig",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:ap-south-1:*:parameter/cloudcart/*"
    }
  ]
}
